{
  "name": "vuetify-project",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "production": "vite build --mode production",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,js,jsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,js,jsx,css,scss}\""
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@supabase/supabase-js": "^2.45.4",
    "date-fns": "^4.1.0",
    "pinia": "^3.0.2",
    "roboto-fontface": "*",
    "uuid": "^10.0.0",
    "vue": "^3.4.31",
    "vue-markdown-render": "^2.2.1",
    "vue-router": "^4.0.13",
    "vuetify": "^3.6.11"
  },
  "devDependencies": {
    "@babel/types": "^7.24.7",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/vue-router": "^2.0.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "prettier": "^3.4.2",
    "sass": "1.77.6",
    "typescript": "^5.4.2",
    "unplugin-fonts": "^1.1.1",
    "unplugin-vue-components": "^0.27.2",
    "vite": "^5.3.3",
    "vite-plugin-vuetify": "^2.0.3",
    "vue-tsc": "^2.0.26"
  }
}
